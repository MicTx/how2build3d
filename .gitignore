.DS_Store

# 本机 agent 会话状态（计划/草稿，不入库）
.zcode/

# Spec Harness 工作树（由 info/exclude 兜底，这里双保险）
.spec/worktrees/

# Spec Harness 运行缓存（archive-index 等，机器生成）
.spec/cache/
